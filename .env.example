# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Decore
NEXT_PUBLIC_SITE_DESCRIPTION=Premium Flowers & Event Decorations in Ethiopia

# Optional integrations
NEXT_PUBLIC_WHATSAPP_NUMBER=2519XXXXXXXX
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Pexels stock photos (server-only — never use NEXT_PUBLIC_)
# https://www.pexels.com/api/
PEXELS_API_KEY=your_pexels_api_key

# After creating Supabase project:
# 1. Run supabase/schema.sql
# 2. Run supabase/storage.sql
# 3. Fill URL and anon key above
